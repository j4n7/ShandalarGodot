; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shandalar"
config/description="Open-source remake of MicroProse's 1997 Magic: The Gathering (Shandalar), with a modular GDScript MTG rules engine."
config/version="0.70.8"
run/main_scene="res://game/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://game/boot_splash.png"
config/icon="res://game/icon.png"
boot_splash/minimum_display_time=1000
config/name.shandalar_test="Shandalar Integration Tests"

[autoload]

Lifecycle="*res://game/lifecycle.gd"
SkinPack="*res://game/skin_pack.gd"
CardPacks="*res://game/card_packs.gd"
ShellMusic="*res://game/shell_music.gd"
TouchControls="*res://game/input/touch_controls.gd"
PadControls="*res://game/input/pad_controls.gd"
ScreenKeyboard="*res://game/input/screen_keyboard.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

